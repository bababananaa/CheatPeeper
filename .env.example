super secret api key= dont push it 
# backend/.env
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
# email for signup verification codes; leave SMTP_HOST empty to print codes to the console instead
# for Gmail: smtp.gmail.com / 587 with an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
